// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis()]
}

// TODO: Define User and authentication models
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   @default("STUDENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TODO: Define Building entity with geospatial center point
model Building {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  latitude    Float
  longitude   Float
  floors      Floor[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// TODO: Define Floor entity with GeoJSON indoor floorplan features
model Floor {
  id              String   @id @default(uuid())
  buildingId      String
  building        Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floorNumber     Int
  name            String
  svgFloorPlanUrl String?
  rooms           Room[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([buildingId, floorNumber])
}

// TODO: Define Room and Occupant entities
model Room {
  id         String   @id @default(uuid())
  floorId    String
  floor      Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  roomNumber String
  name       String?
  type       String   @default("CLASSROOM")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([floorId, roomNumber])
}

// TODO: Define NavNode & NavEdge entities for A* pathfinding graph
model NavNode {
  id         String   @id @default(uuid())
  type       String
  latitude   Float
  longitude  Float
  floorId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
