# MapWave Web Frontend — Environment Configuration Example
# Copy to .env and configure your values. Do NOT commit .env with secrets.

# Backend API Endpoint
VITE_API_URL="http://localhost:3001"

# MapTiler Satellite Imagery API Key (obtain from https://cloud.maptiler.com)
VITE_MAPTILER_KEY=

# Verified Campus Geographic Coordinates (WGS 84 Decimal Degrees)
# Valid latitude must be within [-90.0, 90.0] and longitude within [-180.0, 180.0]
VITE_CAMPUS_LAT=
VITE_CAMPUS_LNG=

# Optional Map Style & Viewport Overrides
# VITE_MAP_STYLE_URL="https://api.maptiler.com/maps/hybrid/style.json?key={key}"
# VITE_CAMPUS_ZOOM=16.8
# VITE_CAMPUS_PITCH=45
# VITE_CAMPUS_BEARING=-17.6
