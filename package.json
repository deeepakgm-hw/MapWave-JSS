{
  "name": "campus-navigator",
  "version": "0.1.0",
  "private": true,
  "description": "Campus Navigator — college indoor/outdoor mapping web app",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"web,api\" -c \"cyan.bold,magenta.bold\" \"npm run dev -w @campus-nav/web\" \"npm run start:dev -w @campus-nav/api\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
