# Database Connection String
DATABASE_URL="postgresql://campus_user:campus_password@localhost:5432/campus_nav"

# Security Secret Key
JWT_SECRET="super-secret-jwt-key-replace-in-production"

# MapLibre Tile Style URL
MAPLIBRE_STYLE_URL="https://demotiles.maplibre.org/style.json"

# Service Ports
PORT=3001
VITE_API_URL="http://localhost:3001"

# MapWave 3D Satellite Campus Map Configuration
# MapTiler API Key (obtain from https://cloud.maptiler.com)
VITE_MAPTILER_KEY=

# Campus Center Coordinates (WGS 84 Decimal Degrees, e.g. 12.9015 / 77.5057)
VITE_CAMPUS_LAT=
VITE_CAMPUS_LNG=

# Optional Map Style & Viewport Overrides
# VITE_MAP_STYLE_URL="https://api.maptiler.com/maps/hybrid/style.json?key={key}"
# VITE_CAMPUS_ZOOM=16.8
# VITE_CAMPUS_PITCH=45
# VITE_CAMPUS_BEARING=-17.6
